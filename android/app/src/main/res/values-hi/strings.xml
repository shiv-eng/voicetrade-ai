    <!-- Onboarding -->
    <string name="onb1_title">बाज़ार से बात करें</string>
    <string name="onb1_body">हिन्दी या अंग्रेज़ी में अपने शेयरों के भाव, होल्डिंग्स और ऑर्डर के बारे में पूछें। मीरा बोलकर जवाब देती है और आपके लिए ऑर्डर भी लगा सकती है।</string>
    <string name="onb2_title">सिर्फ़ प्रैक्टिस ट्रेडिंग</string>
    <string name="onb2_body">आप प्रैक्टिस के पैसों से ट्रेड करते हैं: शुरुआत में ₹10,00,000 और $10,000। भाव असली और लाइव हैं, सिर्फ़ खरीद-बिक्री नकली है, और हर ऑर्डर पहले दोहराया जाता है और आपकी पुष्टि के बाद ही लगता है।</string>
    <string name="onb3_title">मीरा को सुनने दें</string>
    <string name="onb3_body">माइक्रोफ़ोन की अनुमति से आप मीरा से बात कर सकते हैं। इसके बिना भी आप टाइप कर सकते हैं। यह बाद में सिस्टम सेटिंग्स में बदला जा सकता है।</string>
    <string name="allow_microphone">माइक्रोफ़ोन की अनुमति दें</string>
    <string name="not_now">अभी नहीं, मैं टाइप करूँगा</string>
    <string name="disclaimer">VoiceTrade AI प्रैक्टिस अकाउंट पर एक डेमो है। यह निवेश की सलाह नहीं देता। ट्रेडिंग में जोखिम होता है।</string>
