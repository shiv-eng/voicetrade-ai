<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS/WSS only. To pin the backend certificate, add a <domain-config> with a <pin-set> for your host. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
