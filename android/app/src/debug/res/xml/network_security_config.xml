<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds may talk to a local backend over cleartext (emulator host loopback / LAN). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
