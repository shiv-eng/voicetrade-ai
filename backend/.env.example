# Copy to .env (repo root for docker compose, or backend/ for local runs) and fill in. Never commit .env.

# --- Your domain ----------------------------------------------------------------------------------
# The public HTTPS address of this server. Agora's cloud must be able to reach it.
API_DOMAIN=api.yourdomain.com
PUBLIC_BASE_URL=https://api.yourdomain.com

# --- Database (PostgreSQL) ------------------------------------------------------------------------
# docker compose builds DATABASE_URL for you from this password. For a local run without Docker use:
# DATABASE_URL=postgresql://user:password@localhost:5432/voicetrade
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# --- Auth -----------------------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
# OAuth *Web application* client id from Google Cloud Console (the same one you give the Android build).
GOOGLE_CLIENT_IDS=
# Development only. Leave false in production: it lets an app create an account without Google.
ALLOW_GUEST_LOGIN=false

# --- Agora (https://console.agora.io) -------------------------------------------------------------
# Project with Conversational AI enabled. App ID + certificate from the project;
# customer id/secret from Console -> RESTful API. Leave blank to run without voice (typing only).
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# --- The one AI model that thinks (OpenAI) ---------------------------------------------------------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# --- The one speech vendor that hears and speaks, in Hindi and English (https://dashboard.sarvam.ai) ---
SARVAM_API_KEY=

# --- Paper money ----------------------------------------------------------------------------------
START_CASH_INR=1000000
START_CASH_USD=10000
# Fill orders at the last traded price even when the exchange is closed (handy for demos at night).
FILL_WHEN_MARKET_CLOSED=true
